# ---------------------------------------------------------------------------
# Hyperbeam
# ---------------------------------------------------------------------------
# Your API key from https://hyperbeam.com/dashboard
# Test keys start with sk_test_, live keys with sk_live_
# NEVER commit the real value: this file is only a template, .env is ignored.
HYPERBEAM_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hyperbeam REST base URL (rarely needs changing)
HYPERBEAM_API_URL=https://engine.hyperbeam.com/v0

# Virtual computer resolution. 16:9 landscape, because films are landscape.
HB_WIDTH=1280
HB_HEIGHT=720

# Page the virtual browser opens on
HB_START_URL=https://www.google.com

# User agent of the shared browser. Leave empty for the default (desktop
# Chrome). Hyperbeam documents one preset, `chrome_android`, which makes sites
# serve their mobile layout. There is no iPad preset; a raw UA string is passed
# through untouched, but whether the API accepts one is not verified.
HB_USER_AGENT=

# Seconds with no connected client before the VM shuts itself down. Low enough
# that forgotten sessions do not burn test-key minutes, high enough that a
# locked phone does not end the film.
HB_OFFLINE_TIMEOUT=300

# Seconds without input INSIDE the shared browser before Hyperbeam shuts it
# down. 0 disables it, which is what a watch party needs: watching a film is
# precisely two hours of touching nothing. Anything else cuts the film off.
HB_INACTIVE_TIMEOUT=0

# Hard cap on a session's life, in seconds. A backstop against a room nobody
# ever closes. Default: 6 hours, which no single film reaches.
HB_ABSOLUTE_TIMEOUT=21600

# ---------------------------------------------------------------------------
# GIPHY
# ---------------------------------------------------------------------------
# Key from https://developers.giphy.com. GIFs are proxied through the server so
# this never reaches the browser. Without it the GIF button explains what is
# missing instead of failing silently.
GIPHY_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Name shown at the top of the room
ROOM_NAME=Sala de cine

# How long the room waits for a disconnected host before handing it to someone
# else, in milliseconds. Locking a phone drops the socket, so this needs to be
# generous. Default: 3 minutes.
ROOM_OWNER_GRACE_MS=180000

# How long an empty room is remembered, in milliseconds. The room itself is
# just memory, so this is generous: a tunnel or a locked phone should not
# destroy a code people have already shared. Default: 15 minutes.
ROOM_EMPTY_TTL_MS=900000

# How long an empty room keeps its virtual computer running, in milliseconds.
# This one does cost money per minute, so it is short. Default: 90 seconds.
ROOM_IDLE_SESSION_MS=90000

PORT=3000
