# ---------------------------------------------------------------------------
# Hyperbeam
# ---------------------------------------------------------------------------
# Your API key from https://hyperbeam.com/dashboard
# Test keys start with sk_test_, live keys with sk_live_
# NEVER commit the real value: this file is only a template, .env is ignored.
HYPERBEAM_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hyperbeam REST base URL (rarely needs changing)
HYPERBEAM_API_URL=https://engine.hyperbeam.com/v0

# Virtual computer resolution. 16:9 landscape, because films are landscape.
HB_WIDTH=1280
HB_HEIGHT=720

# Page the virtual browser opens on
HB_START_URL=https://www.google.com

# User agent of the shared browser. Leave empty for the default (desktop
# Chrome). Hyperbeam documents one preset, `chrome_android`, which makes sites
# serve their mobile layout. There is no iPad preset; a raw UA string is passed
# through untouched, but whether the API accepts one is not verified.
HB_USER_AGENT=

# Seconds with no connected client before Hyperbeam itself shuts the VM down.
# This is only the safety net for a server that dies without cleaning up: an
# empty room's browser is switched off by the room (ROOM_IDLE_SESSION_MS
# below). Leave it unset and it is worked out from ROOM_IDLE_SESSION_MAX_MS
# plus a minute; setting it LOWER than that would cut short whatever delay a
# host picks in Settings.
# HB_OFFLINE_TIMEOUT=1860

# Strict control: sessions start with nobody allowed to steer the shared
# browser, and the host and moderators (who hold the session's admin token)
# grant it to themselves — so who may steer is enforced by Hyperbeam, not just
# by this app's page. Off by default: it relies on the API accepting
# `control_disable_default`, and if it refuses, the session still opens and
# this is ignored (the log says so). Try it with your account before relying on it.
# HB_LOCK_CONTROL=true

# Seconds without input INSIDE the shared browser before Hyperbeam shuts it
# down. 0 disables it, which is what a watch party needs: watching a film is
# precisely two hours of touching nothing. Anything else cuts the film off.
HB_INACTIVE_TIMEOUT=0

# Hard cap on a session's life, in seconds. A backstop against a room nobody
# ever closes. Default: 6 hours, which no single film reaches.
HB_ABSOLUTE_TIMEOUT=21600

# ---------------------------------------------------------------------------
# GIPHY
# ---------------------------------------------------------------------------
# Key from https://developers.giphy.com. GIFs are proxied through the server so
# this never reaches the browser. Without it the GIF button explains what is
# missing instead of failing silently.
GIPHY_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Name shown at the top of the room
ROOM_NAME=Sala de cine

# How long the room waits for a disconnected host before handing it to someone
# else, in milliseconds. Locking a phone drops the socket, so this needs to be
# generous. Default: 3 minutes.
ROOM_OWNER_GRACE_MS=180000

# How long an EMPTY room is remembered, in milliseconds. A room with anyone
# inside never expires. Default: a whole day — the code a group shared should
# not evaporate overnight. At MAX_ROOMS, the longest-empty room yields its
# slot to a new one, so ghosts never block real people.
ROOM_EMPTY_TTL_MS=86400000

# How long an EMPTY room keeps its virtual computer running, in milliseconds.
# Two minutes: enough for a refresh, a tunnel or a short screen lock, and no
# longer — the machine is billed by the minute whether or not anyone watches.
# The host can raise it in Settings (1, 2, 5, 10, 15, 30 min), up to:
ROOM_IDLE_SESSION_MS=120000
# The ceiling for that choice, in milliseconds (default 30 minutes).
# ROOM_IDLE_SESSION_MAX_MS=1800000

PORT=3000

# ---------------------------------------------------------------------------
# Producción y venta a clientes (ver «Producción y venta a clientes» en el README)
# ---------------------------------------------------------------------------
# En producción el público ve mensajes amables y nada de diagnósticos.
# NODE_ENV=production

# Marca blanca: todo opcional.
# BRAND_NAME=Cine Nova
# BRAND_SHORT_NAME=Nova
# BRAND_TAGLINE=Tu cine privado, con quien quieras.
# BRAND_ACCENT=#ff375f
# BRAND_LOGO_URL=https://cliente.com/logo.png
# BRAND_SUPPORT_URL=https://cliente.com/ayuda
# BRAND_TERMS_URL=https://cliente.com/terminos
# BRAND_PRIVACY_URL=https://cliente.com/privacidad
# Carpeta con icon-32.png, icon-180.png, icon-192.png e icon-512.png propios.
# BRAND_ASSETS_DIR=/data/brand
# Dónde puede incrustarse la app (por defecto, en ninguna web).
# FRAME_ANCESTORS=https://cliente.com

# Quién puede abrir un navegador compartido (lo único que gasta minutos).
# Formato Cliente=código, separados por comas; 8 caracteres o más cada código.
# Sin esto, cualquiera que esté en una sala puede abrir uno.
# ACCESS_CODES=Acme Corp=acme-7Hk2-93xQ,Globex=globex-Zr4t-81bN

# Techo de gasto: máquinas virtuales vivas a la vez (0 = sin tope).
MAX_SESSIONS=10
# MAX_VIEWERS_PER_ROOM=50
# MAX_SOCKETS_PER_IP=30
# Multiplica todos los límites por IP (oficinas tras una sola IP).
# RATE_LIMIT_MULTIPLIER=1

# Panel de uso por cliente en /api/admin/usage (16 caracteres o más).
# ADMIN_TOKEN=cambia-esto-por-algo-largo-y-aleatorio
# Dónde se guardan el estado de las salas y los minutos por cliente. En Fly,
# apúntalos a un volumen montado, o se borran en cada despliegue.
# ROOM_STATE_FILE=/data/rooms-state.json
# USAGE_FILE=/data/usage.jsonl
